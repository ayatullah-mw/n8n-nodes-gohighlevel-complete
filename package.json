{
  "name": "n8n-nodes-gohighlevel-complete",
  "version": "1.0.0",
  "description": "n8n Community Node for GoHighLevel CRM — automate Contacts, Opportunities, Calendars, and Workflows",
  "keywords": [
    "n8n-community-node-package",
    "gohighlevel",
    "gohighlevel-complete",
    "highlevel",
    "crm",
    "automation"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ayatullah-mw/n8n-nodes-gohighlevel-complete",
  "author": {
    "name": "Your Name",
    "email": "your@email.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ayatullah-mw/n8n-nodes-gohighlevel-complete.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "lint": "eslint nodes credentials --ext .ts",
    "lintfix": "eslint nodes credentials --ext .ts --fix",
    "format": "prettier --write \"**/*.ts\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build && npm run lint && npm test"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/GoHighLevelApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/GoHighLevel/GoHighLevel.node.js",
      "dist/nodes/GoHighLevel/GoHighLevelSmart.node.js"
    ]
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "n8n-workflow": "^1.61.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.4"
  },
  "peerDependencies": {
    "n8n-workflow": ">=1.0.0"
  },
  "engines": {
    "node": ">=18.10",
    "pnpm": ">=9.1"
  }
}
